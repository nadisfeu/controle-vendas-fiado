# Copie para .env e preencha. O .env NÃO deve ir para o git nem ser compartilhado.
# Senha para entrar no site (na internet: pelo menos 12 caracteres; uma frase de 4 palavras é fácil de lembrar):
APP_SENHA=troque-esta-senha
# Chave secreta das sessões (texto longo e aleatório):
APP_CHAVE=gere-com: python3 -c "import secrets; print(secrets.token_hex(32))"
# Opcionais:
# APP_BANCO=            caminho do banco (padrão: dados.db nesta pasta)
# APP_FUSO=America/Sao_Paulo   fuso horário das datas (servidores costumam estar em UTC)
# APP_PASTA_COPIAS=     onde guardar a cópia automática diária (padrão: backups/automaticas)
# APP_MINUTOS_INATIVO=60  sem usar por esse tempo, pede a senha de novo
# APP_PORTA=5000        só para rodar no próprio computador
