# Copie para .env e preencha. O .env NÃO deve ir para o git nem ser compartilhado.
# Senha para entrar no site:
APP_SENHA=troque-esta-senha
# Chave secreta das sessões (qualquer texto longo e aleatório):
APP_CHAVE=gere-com: python3 -c "import secrets; print(secrets.token_hex(32))"
# Opcional: caminho do banco (padrão: dados.db nesta pasta) e porta (padrão: 5000)
# APP_BANCO=
# APP_PORTA=5000
